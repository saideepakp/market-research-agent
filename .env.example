# Copy this file to .env and fill in your keys.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Recommended (free) ---
COINGECKO_API_KEY=                 # https://www.coingecko.com/en/api (free Demo key)
FINNHUB_API_KEY=                   # https://finnhub.io (free key, personal use)
FRED_API_KEY=                      # https://fred.stlouisfed.org/docs/api/api_key.html
SEC_USER_AGENT=YourName your-email@example.com   # SEC requires a name + email
# Web search uses DuckDuckGo: no key needed.

# --- Observability (optional, free) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com   # or https://cloud.langfuse.com (EU)

# --- App password (optional; recommended when deployed online) ---
APP_PASSWORD=

# --- Tools ---
TOOL_MODE=mcp                      # mcp (tools from MCP servers) or direct (import tools.py)
MCP_CONFIG=mcp_servers.json        # which MCP servers to connect to

# --- Usage limits (optional) ---
# Defaults are set below each free plan; see usage.py. Override any of them here.
# Format: LIMIT_<SOURCE>_<MINUTE|DAY|MONTH>=number   (0 blocks that source)
# Sources: COINGECKO, FINNHUB, FRED, SEC, CFTC, YFINANCE, DDGS
# LIMIT_COINGECKO_MONTH=9000
# LIMIT_YFINANCE_MONTH=30000
# LIMIT_CFTC_MONTH=3000

# --- Options math (optional) ---
# Fallback risk-free rate if the T-bill yield can't be fetched (decimal, 0.04 = 4%)
RISK_FREE_RATE=0.04

# --- Optional settings ---
ANTHROPIC_MODEL=claude-sonnet-5-5
MEMORY_DB=memory.db
